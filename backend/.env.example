# Backend Environment Variables
NODE_ENV=development
PORT=5001
# URL-encode special characters in the password (e.g. $ -> %24, @ -> %40).
# If auth fails but the URI looks right, check for a stale MONGODB_URI in Windows "Environment Variables" or your shell profile — the server loads backend/.env explicitly and in dev prefers that file over pre-set vars.
MONGODB_URI=mongodb://localhost:27017/league-scheduler
JWT_SECRET=your-super-secure-jwt-secret-here-replace-with-random-string
ADMIN_JWT_SECRET=your-super-secure-jwt-secret-here-replace-with-random-string
ADMIN_EMAIL=your-admin-email@example.com
# Optional comma-separated list; when set and non-empty, overrides ADMIN_EMAIL for whitelist
# ADMIN_EMAILS=admin1@example.com,admin2@example.com

# Production Settings (Replace with your actual values)
# NODE_ENV=production
# MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/YOUR_DATABASE
# JWT_SECRET=your-production-jwt-secret-generate-with-crypto-random-bytes

# CORS Configuration (add your Vercel domain here)
FRONTEND_URL=https://your-app-name.vercel.app

# Fantasy: skip 6-digit email verification (register returns token; login works unverified). NEVER enable in production.
# FANTASY_BYPASS_EMAIL_VERIFY=true

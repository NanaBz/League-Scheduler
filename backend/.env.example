# Backend Environment Variables
# Copy to backend/.env for local development. Never commit real secrets.

# --- Core ---
NODE_ENV=development
PORT=5001
HOST=0.0.0.0

# MongoDB (required in production)
# URL-encode special characters in the password (e.g. $ -> %24, @ -> %40).
MONGODB_URI=mongodb://localhost:27017/league-scheduler

# --- Authentication (required in production) ---
# Admin JWT — signs admin panel sessions (24h expiry)
ADMIN_JWT_SECRET=your-admin-jwt-secret-replace-with-random-string
# Fantasy JWT — MUST be distinct from ADMIN_JWT_SECRET in production
FANTASY_JWT_SECRET=your-fantasy-jwt-secret-replace-with-random-string
# Legacy dev fallback only; not used when NODE_ENV=production
JWT_SECRET=your-super-secure-jwt-secret-here-replace-with-random-string

# Admin whitelist (at least one required for admin login)
ADMIN_EMAIL=your-admin-email@example.com
# Optional comma-separated list; when set and non-empty, overrides ADMIN_EMAIL
# ADMIN_EMAILS=admin1@example.com,admin2@example.com

# --- CORS & frontend (required in production) ---
# Comma-separated browser origins allowed to call the API, e.g. https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- Fantasy auth (recommended for production without email OTP) ---
# Skip email verification on register/login. Accounts are active immediately.
FANTASY_SKIP_EMAIL_VERIFY=true

# Google Sign-In — same client ID as REACT_APP_GOOGLE_CLIENT_ID on the frontend
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Shown on forgot-password when email reset is unavailable
# FANTASY_ADMIN_CONTACT_EMAIL=admin@example.com

# --- Email (optional when FANTASY_SKIP_EMAIL_VERIFY=true) ---
# Only needed if you want password reset emails later.
# Option A: Resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=ACity Fantasy <noreply@yourdomain.com>

# Option B: SMTP
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_FROM=noreply@example.com

# Password reset link TTL (minutes)
PASSWORD_RESET_TTL_MINUTES=60

# --- Local dev only ---
# Legacy alias for FANTASY_SKIP_EMAIL_VERIFY in development
# FANTASY_BYPASS_EMAIL_VERIFY=true

# --- Production example (uncomment and replace) ---
# NODE_ENV=production
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/DATABASE
# ADMIN_JWT_SECRET=<crypto-random-64-chars>
# FANTASY_JWT_SECRET=<different-crypto-random-64-chars>
# CORS_ORIGINS=https://your-frontend.vercel.app
# FRONTEND_URL=https://your-frontend.vercel.app
# FANTASY_SKIP_EMAIL_VERIFY=true
# GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
